{
  "name": "url-shorten",
  "version": "2.0.0",
  "private": true,
  "description": "URL Shortener & Analytics Platform",
  "workspaces": [
    "packages/shared",
    "services/url-service",
    "services/analytics-service"
  ],
  "scripts": {
    "start:url": "node services/url-service/app.js",
    "start:url2": "cross-env PORT=3002 node services/url-service/app.js",
    "start:analytics": "node services/analytics-service/app.js",
    "start:consumer": "node services/analytics-service/consumer.js",
    "start:gateway": "node gateway/app.js",
    "dev:url": "node --watch services/url-service/app.js",
    "dev:url2": "cross-env PORT=3002 node --watch services/url-service/app.js",
    "dev:analytics": "node --watch services/analytics-service/app.js",
    "dev:consumer": "node --watch services/analytics-service/consumer.js",
    "dev:consumer1": "cross-env INSTANCE_ID=consumer-1 node services/analytics-service/consumer.js",
    "dev:consumer2": "cross-env INSTANCE_ID=consumer-2 node services/analytics-service/consumer.js",
    "dev:consumer3": "cross-env INSTANCE_ID=consumer-3 node services/analytics-service/consumer.js",
    "dev:gateway": "node --watch gateway/app.js",
    "dev": "concurrently -k -n url,url2,analytics,gateway,consumer-1,consumer-2,consumer-3 -c blue,cyan,green,yellow,magenta,brightMagenta,brightBlue \"npm:dev:url\" \"npm:dev:url2\" \"npm:dev:analytics\" \"npm:dev:gateway\" \"npm:dev:consumer1\" \"npm:dev:consumer2\" \"npm:dev:consumer3\"",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=prisma/schema.prisma",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "kafka:init": "docker compose run --rm kafka-init"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "prisma": "^7.10.0"
  }
}
