    {
      "name": "Shorten URL (rate limited)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/shorten",
          "host": ["{{baseUrl}}"],
          "path": ["shorten"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const baseUrl = pm.collectionVariables.get('baseUrl');",
              "const email = 'ratelimit_' + Date.now() + '@example.com';",
              "",
              "const signup = {",
              "  url: baseUrl + '/signup',",
              "  method: 'POST',",
              "  header: [{ key: 'Content-Type', value: 'application/json' }],",
              "  body: { mode: 'raw', raw: JSON.stringify({ email, password: 'password123' }) }",
              "};",
              "",
              "const login = {",
              "  url: baseUrl + '/login',",
              "  method: 'POST',",
              "  header: [{ key: 'Content-Type', value: 'application/json' }],",
              "  body: { mode: 'raw', raw: JSON.stringify({ email, password: 'password123' }) }",
              "};",
              "",
              "const shorten = (token, i) => ({",
              "  url: baseUrl + '/shorten',",
              "  method: 'POST',",
              "  header: [",
              "    { key: 'Content-Type', value: 'application/json' },",
              "    { key: 'Authorization', value: 'Bearer ' + token }",
              "  ],",
              "  body: { mode: 'raw', raw: JSON.stringify({ url: 'https://example.com/rate-limit-' + i }) }",
              "});",
              "",
              "pm.sendRequest(signup, () => {",
              "  pm.sendRequest(login, (loginErr, loginRes) => {",
              "    const token = loginRes.json().token;",
              "    let sent = 0;",
              "    const sendNext = () => {",
              "      if (sent >= 5) {",
              "        pm.sendRequest(shorten(token, 6), (err, res) => {",
              "          pm.test('Rate limited to 429 on the 6th request', () => {",
              "            pm.expect(res.code).to.equal(429);",
              "            pm.expect(res.json().error).to.include('Rate limit exceeded');",
              "          });",
              "        });",
              "        return;",
              "      }",
              "      pm.sendRequest(shorten(token, sent), (err, res) => {",
              "        sent++;",
              "        sendNext();",
              "      });",
              "    };",
              "    sendNext();",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
