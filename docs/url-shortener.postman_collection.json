{
  "info": {
    "name": "URL Shortener API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Body has message field', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Shorten URL (valid)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/shorten",
          "host": ["{{baseUrl}}"],
          "path": ["shorten"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 or 200', () => {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has required fields', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('id');",
              "  pm.expect(body).to.have.property('shortCode');",
              "  pm.expect(body).to.have.property('longUrl', 'https://example.com');",
              "  pm.expect(body).to.have.property('createdAt');",
              "});",
              "",
              "pm.test('Short code is 7 characters', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.shortCode).to.have.lengthOf(7);",
              "});",
              "",
              "pm.collectionVariables.set('shortCode', pm.response.json().shortCode);"
            ]
          }
        }
      ]
    },
    {
      "name": "Shorten URL (duplicate)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/shorten",
          "host": ["{{baseUrl}}"],
          "path": ["shorten"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns existing short code', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('shortCode');",
              "  pm.expect(body.shortCode).to.equal(pm.collectionVariables.get('shortCode'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Shorten URL (invalid - empty body)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/shorten",
          "host": ["{{baseUrl}}"],
          "path": ["shorten"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Response has error field', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('error');",
              "  pm.expect(body.error).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Shorten URL (invalid - bad url)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/shorten",
          "host": ["{{baseUrl}}"],
          "path": ["shorten"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"javascript:alert(1)\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Response has error about URL scheme', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('error');",
              "  pm.expect(body.error).to.equal('URL must start with http:// or https://');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Shorten URL (invalid - non-http scheme)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/shorten",
          "host": ["{{baseUrl}}"],
          "path": ["shorten"]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"ftp://example.com/file.txt\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "pm.test('Response has error about URL scheme', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('error');",
              "  pm.expect(body.error).to.equal('URL must start with http:// or https://');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Redirect URL (valid)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/{{shortCode}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{shortCode}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 302', () => {",
              "  pm.response.to.have.status(302);",
              "});",
              "",
              "pm.test('Response has Location header', () => {",
              "  pm.response.to.have.header('Location');",
              "  pm.expect(pm.response.headers.get('Location')).to.equal('https://example.com');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Redirect URL (not found)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/nonexistent123",
          "host": ["{{baseUrl}}"],
          "path": ["nonexistent123"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Response has error field', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('error');",
              "  pm.expect(body.error).to.equal('URL not found');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown route",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/some-random-path",
          "host": ["{{baseUrl}}"],
          "path": ["some-random-path"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Response has error field', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('error');",
              "  pm.expect(body.error).to.equal('Route not found');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
