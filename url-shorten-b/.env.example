DATABASE_URL="postgresql://postgres:password@localhost:5432/url_shorten"
JWT_SECRET="change-me-to-a-random-secret"
JWT_EXPIRES_IN=2d

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# Kafka / Redpanda configuration (comma-separated for multiple brokers)
KAFKA_BROKER=localhost:9092
