# Server
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/url_shorten"

# JWT Authentication
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN=1h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# Kafka / Redpanda (comma-separated for multiple brokers)
KAFKA_BROKER=localhost:9092

# CORS — comma-separated allowed origins (unset = allow all; local dev only)
# CORS_ORIGIN=http://localhost:3000
