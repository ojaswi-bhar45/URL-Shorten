# ==============================================
# URL Shortener & Analytics Platform
# Copy this file to .env and fill in values
# ==============================================

# --- Server (url-service) ---
PORT=3001
LOG_LEVEL=info

# --- PostgreSQL (used by both services) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/urlshortener"
DATABASE_REPLICA_URL="postgresql://postgres:password@localhost:5433/urlshortener"

# --- JWT (url-service only) ---
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN=1h

# --- Redis (url-service only: cache + rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# --- Kafka / Redpanda ---
KAFKA_BROKER=localhost:9092

# --- CORS (url-service; comma-separated origins; unset = allow all) ---
# CORS_ORIGIN=http://localhost:3000

# --- Gateway (public entry point; routes to url-service 3001 + analytics-service 4000) ---
GATEWAY_PORT=3000
URL_SERVICE_URL=http://localhost:3001
ANALYTICS_SERVICE_URL=http://localhost:4000

# --- Docker / Postgres containers (read by docker-compose.yml) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=urlshortener
REPLICATION_PASSWORD=replpass123
