# ==============================================
# URL Shortener & Analytics Platform
# Copy this file to .env and fill in values
# ==============================================

# --- Server (url-service) ---
PORT=3001
LOG_LEVEL=info
ANALYTICS_PORT=4000

# --- PostgreSQL (used by both services) ---
DATABASE_URL="postgresql://postgres:password@localhost:5432/urlshortener"
DATABASE_REPLICA_URL="postgresql://postgres:password@localhost:5433/urlshortener"

# --- JWT (url-service only) ---
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN=1h

# --- Redis (url-service only: cache + rate limiting) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# --- Kafka / Redpanda ---
# Comma-separated list is supported (kafka.js / consumer.js both split on ",")
KAFKA_BROKER=localhost:9092
# Partition count for the link-clicked topic, applied by the kafka-init
# service in docker-compose.yml. This is the hard ceiling on consumer-group
# parallelism: you can run at most this many useful consumer instances, and
# any extra instance sits idle. Only affects topics that don't exist yet.
KAFKA_TOPIC_PARTITIONS=3
# Per-consumer log label. Set a distinct value in each consumer terminal
# (consumer-1, consumer-2, ...) so their output is distinguishable — every
# instance defaults to "consumer-1" when unset.
INSTANCE_ID=

# --- CORS (url-service; comma-separated origins; unset = allow all) ---
# CORS_ORIGIN=http://localhost:3000

# --- Gateway (public entry point; routes to url-service 3001 + analytics-service 4000) ---
GATEWAY_PORT=3000
URL_SERVICE_URL=http://localhost:9000
ANALYTICS_SERVICE_URL=http://localhost:4000

# --- Docker / Postgres containers (read by docker-compose.yml) ---
# IMPORTANT: generate strong random values, never ship real secrets here
POSTGRES_USER=admin
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=urlshortener
REPLICATION_PASSWORD=REPLACE_WITH_STRONG_REPLICATION_PASSWORD
