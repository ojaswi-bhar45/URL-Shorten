# Server
PORT=3001

# PostgreSQL — primary (consumer writes click_events + clickCount), replica (analytics reads)
DATABASE_URL="postgresql://postgres:password@localhost:5432/url_shorten"
DATABASE_REPLICA_URL="postgresql://postgres:password@localhost:5433/url_shorten"

# Kafka / Redpanda (comma-separated for multiple brokers)
KAFKA_BROKER=localhost:9092
