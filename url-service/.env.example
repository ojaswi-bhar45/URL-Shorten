# Server
PORT=3000

# PostgreSQL — primary accepts all writes; replica serves analytics reads
DATABASE_URL="postgresql://postgres:password@localhost:5432/url_shorten"
DATABASE_REPLICA_URL="postgresql://postgres:password@localhost:5433/url_shorten"

# PostgreSQL containers (read by docker-compose.yml)
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=urlshortener

# Streaming replication role (primary init + replica bootstrap)
REPLICATION_PASSWORD=change-me-replication-password

# JWT Authentication
JWT_SECRET="replace-with-a-strong-random-secret"
JWT_EXPIRES_IN=1h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password

# Kafka / Redpanda (comma-separated for multiple brokers)
KAFKA_BROKER=localhost:9092

# CORS — comma-separated allowed origins (unset = allow all; local dev only)
# CORS_ORIGIN=http://localhost:3000
